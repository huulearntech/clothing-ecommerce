<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Confirmation</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f6f8;
      margin: 0;
      padding: 0;
      color: #333333;
    }
    .email-container {
      max-width: 600px;
      margin: 30px auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }
    .header {
      background-color: #0f172a;
      color: #ffffff;
      padding: 24px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
      letter-spacing: 0.5px;
    }
    .body {
      padding: 30px 24px;
    }
    .greeting {
      font-size: 18px;
      font-weight: 600;
      color: #0f172a;
      margin-bottom: 12px;
    }
    .text {
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      margin-bottom: 24px;
    }
    .order-details-box {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 24px;
    }
    .order-details-box div {
      font-size: 14px;
      color: #334155;
      margin-bottom: 6px;
    }
    .order-details-box div:last-child {
      margin-bottom: 0;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }
    .table th {
      background-color: #f1f5f9;
      color: #334155;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px;
      text-align: left;
      border-bottom: 2px solid #e2e8f0;
    }
    .table td {
      padding: 12px 10px;
      font-size: 14px;
      color: #334155;
      border-bottom: 1px solid #e2e8f0;
    }
    .summary-table {
      width: 50%;
      margin-left: auto;
      border-collapse: collapse;
      margin-bottom: 24px;
    }
    .summary-table td {
      padding: 6px 10px;
      font-size: 14px;
      color: #475569;
    }
    .summary-table tr.total td {
      font-weight: 700;
      font-size: 16px;
      color: #0f172a;
      border-top: 2px solid #e2e8f0;
      padding-top: 10px;
    }
    .footer {
      background-color: #f8fafc;
      padding: 20px;
      text-align: center;
      font-size: 13px;
      color: #94a3b8;
      border-top: 1px solid #e2e8f0;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>Thank You for Your Order!</h1>
    </div>
    <div class="body">
      <div class="greeting">Hello {{customerName}},</div>
      <div class="text">
        We have received your order and are preparing it for shipment. Below are the details of your purchase:
      </div>

      <div class="order-details-box">
        <div><strong>Order Number:</strong> #{{orderNumber}}</div>
        <div><strong>Order Date:</strong> {{orderDate}}</div>
        <div><strong>Order Status:</strong> {{status}}</div>
      </div>

      <table class="table">
        <thead>
          <tr>
            <th>Item</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td>
              <strong>{{this.name}}</strong>
              {{#if this.size}}<br><small style="color: #64748b;">Size: {{this.size}}</small>{{/if}}
              {{#if this.color}}<small style="color: #64748b;"> | Color: {{this.color}}</small>{{/if}}
            </td>
            <td>{{this.quantity}}</td>
            <td>${{this.unitPrice}}</td>
            <td>${{this.totalPrice}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <table class="summary-table">
        <tbody>
          <tr>
            <td>Subtotal:</td>
            <td style="text-align: right;">${{subtotalAmount}}</td>
          </tr>
          {{#if discountAmount}}
          <tr>
            <td>Discount:</td>
            <td style="text-align: right;">-${{discountAmount}}</td>
          </tr>
          {{/if}}
          <tr>
            <td>Shipping:</td>
            <td style="text-align: right;">${{shippingFee}}</td>
          </tr>
          <tr>
            <td>Tax:</td>
            <td style="text-align: right;">${{taxAmount}}</td>
          </tr>
          <tr class="total">
            <td>Total:</td>
            <td style="text-align: right;">${{totalAmount}}</td>
          </tr>
        </tbody>
      </table>

      {{#if shippingAddress}}
      <div class="order-details-box">
        <div style="font-weight: 600; margin-bottom: 8px;">Shipping Address</div>
        <div>{{shippingAddress.fullName}}</div>
        <div>{{shippingAddress.street}} {{shippingAddress.addressLine1}}</div>
        <div>{{shippingAddress.city}}, {{shippingAddress.state}} {{shippingAddress.postalCode}}</div>
        <div>{{shippingAddress.country}}</div>
      </div>
      {{/if}}

      <div class="text" style="margin-bottom: 0;">
        If you have any questions regarding your order, please reply to this email or contact customer support.
      </div>
    </div>
    <div class="footer">
      &copy; Shop App. All rights reserved.
    </div>
  </div>
</body>
</html>
